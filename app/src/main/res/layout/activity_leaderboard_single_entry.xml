<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/spacing_sm"
    android:paddingEnd="@dimen/spacing_sm"
    android:paddingTop="@dimen/spacing_sm"
    android:paddingBottom="@dimen/spacing_sm"
    android:gravity="center_vertical"
    android:id="@+id/entryContainer">

    <!-- Rank — matches header "#" column (40dp) -->
    <TextView
        android:id="@+id/entryRank"
        android:layout_width="40dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textSize="@dimen/text_body"
        android:textStyle="bold" />

    <!-- Avatar — matches header spacer (36dp) -->
    <de.hdodenhof.circleimageview.CircleImageView
        android:id="@+id/userProfilePic"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:src="@drawable/actifit_logo"
        app:civ_border_width="0dp"
        android:layout_marginEnd="4dp" />

    <!-- Username — flexible, matches header weight=1 column -->
    <TextView
        android:id="@+id/userName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textSize="@dimen/text_body"
        android:paddingStart="@dimen/spacing_xs"
        android:ellipsize="end"
        android:maxLines="1" />

    <!-- Steps — matches header "Steps" column (80dp) -->
    <TextView
        android:id="@+id/activityCount"
        android:layout_width="80dp"
        android:layout_height="wrap_content"
        android:gravity="end|center_vertical"
        android:textSize="@dimen/text_body" />

    <!-- Details button — matches header spacer (44dp) -->
    <LinearLayout
        android:layout_width="44dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingStart="@dimen/spacing_xs">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/entryDetailsBtn"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:fontFamily="@font/font_awesome_6_solid"
            android:text="&#xf15c;"
            android:textSize="15sp"
            android:gravity="center"
            android:textColor="@color/text_on_actifit_red"
            android:background="@drawable/actifit_button_ripple_bg"
            android:padding="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp" />

    </LinearLayout>

</LinearLayout>
