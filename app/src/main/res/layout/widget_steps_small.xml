<?xml version="1.0" encoding="utf-8"?>
<!-- Steps widget, small (2x2): the dashboard's three activity rings (steps, distance, calories)
     around the companion animal, today's steps below, Actifit logo in the corner.
     Texts are set by WidgetUpdater so they follow the in-app language. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:padding="4dp">

    <ImageView
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_gravity="top|start"
        android:layout_margin="4dp"
        android:importantForAccessibility="no"
        android:src="@drawable/actifit_logo" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical">

        <!-- ring insets 10.4% / 20.8% of the size: see the widget_ring_* drawables -->
        <FrameLayout
            android:layout_width="80dp"
            android:layout_height="80dp">

            <ProgressBar
                android:id="@+id/widget_ring_steps"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:indeterminate="false"
                android:max="100"
                android:progressDrawable="@drawable/widget_ring_steps" />

            <ProgressBar
                android:id="@+id/widget_ring_distance"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_margin="8dp"
                android:indeterminate="false"
                android:max="100"
                android:progressDrawable="@drawable/widget_ring_distance" />

            <ProgressBar
                android:id="@+id/widget_ring_kcal"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_margin="17dp"
                android:indeterminate="false"
                android:max="100"
                android:progressDrawable="@drawable/widget_ring_kcal" />

            <ImageView
                android:id="@+id/widget_animal"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter" />

            <TextView
                android:id="@+id/widget_animal_emoji"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:textSize="18sp"
                android:visibility="gone" />
        </FrameLayout>

        <TextView
            android:id="@+id/widget_steps"
            android:layout_width="match_parent"
            android:layout_height="20dp"
            android:autoSizeMaxTextSize="16sp"
            android:autoSizeMinTextSize="10sp"
            android:autoSizeTextType="uniform"
            android:gravity="center"
            android:maxLines="1"
            android:textColor="@color/widget_text_primary"
            android:textStyle="bold" />

        <!-- shown instead of the step count when synced data is not from today -->
        <TextView
            android:id="@+id/widget_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:textColor="@color/widget_accent"
            android:textSize="11sp"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
