<?xml version="1.0" encoding="utf-8"?>
<!-- The video attached to the report (PostSteemitActivity.showAttachedVideo). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/attachedVideoCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/vid_bg_attached"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp"
    android:visibility="gone">

    <FrameLayout
        android:id="@+id/attachedThumbFrame"
        android:layout_width="72dp"
        android:layout_height="100dp"
        android:background="@drawable/vid_bg_thumb"
        android:clickable="true"
        android:contentDescription="@string/vids_play"
        android:focusable="true">

        <ImageView
            android:id="@+id/attachedThumb"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop" />

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:src="@drawable/vid_ic_play" />

        <TextView
            android:id="@+id/attachedDuration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="5dp"
            android:background="@drawable/vid_bg_badge"
            android:paddingStart="5dp"
            android:paddingTop="2dp"
            android:paddingEnd="5dp"
            android:paddingBottom="2dp"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/vid_attached_title"
            android:textColor="@color/vid_text"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/attachedBody"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/vid_chip_grey_fg"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/attachedChange"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:minWidth="0dp"
                android:paddingStart="0dp"
                android:paddingEnd="16dp"
                android:text="@string/vid_change"
                android:textAllCaps="false"
                android:textColor="@color/vid_red_text"
                android:textSize="14sp" />

            <Button
                android:id="@+id/attachedRemove"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:minWidth="0dp"
                android:paddingStart="0dp"
                android:paddingEnd="8dp"
                android:text="@string/vid_remove"
                android:textAllCaps="false"
                android:textColor="@color/vid_chip_grey_fg"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
