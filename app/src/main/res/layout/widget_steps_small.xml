<?xml version="1.0" encoding="utf-8"?>
<!-- Steps widget, small (2x2): the dashboard's three activity rings (steps, distance, calories)
     around the companion animal, today's steps below, Actifit logo top-left, the user's avatar
     top-right. Texts are set by WidgetUpdater so they follow the in-app language. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:padding="3dp">

    <ImageView
        android:layout_width="14dp"
        android:layout_height="14dp"
        android:layout_gravity="top|start"
        android:layout_margin="3dp"
        android:importantForAccessibility="no"
        android:src="@drawable/actifit_logo" />

    <ImageView
        android:id="@+id/widget_avatar"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_gravity="top|end"
        android:layout_margin="2dp"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical">

        <!-- ring insets 7dp / 14dp of 68dp (10% / 21%): see the widget_ring_* drawables -->
        <FrameLayout
            android:layout_width="68dp"
            android:layout_height="68dp">

            <ProgressBar
                android:id="@+id/widget_ring_steps"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:indeterminate="false"
                android:max="100"
                android:progressDrawable="@drawable/widget_ring_steps" />

            <ProgressBar
                android:id="@+id/widget_ring_distance"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_margin="7dp"
                android:indeterminate="false"
                android:max="100"
                android:progressDrawable="@drawable/widget_ring_distance" />

            <ProgressBar
                android:id="@+id/widget_ring_kcal"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_margin="14dp"
                android:indeterminate="false"
                android:max="100"
                android:progressDrawable="@drawable/widget_ring_kcal" />

            <ImageView
                android:id="@+id/widget_animal"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter" />

            <TextView
                android:id="@+id/widget_animal_emoji"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:textSize="15sp"
                android:visibility="gone" />
        </FrameLayout>

        <TextView
            android:id="@+id/widget_steps"
            android:layout_width="match_parent"
            android:layout_height="18dp"
            android:autoSizeMaxTextSize="14sp"
            android:autoSizeMinTextSize="9sp"
            android:autoSizeTextType="uniform"
            android:gravity="center"
            android:maxLines="1"
            android:textColor="@color/widget_text_primary"
            android:textStyle="bold" />

        <!-- shown instead of the step count when synced data is not from today -->
        <TextView
            android:id="@+id/widget_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:textColor="@color/widget_accent"
            android:textSize="10sp"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
