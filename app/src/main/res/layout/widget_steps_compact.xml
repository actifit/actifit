<?xml version="1.0" encoding="utf-8"?>
<!-- Steps widget, compact (1x1 / 2x1): the three rings around the companion, plus today's steps
     beside them when there is room (WidgetState.SIZES). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:padding="@dimen/widget_padding_tight">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- rings 44dp, insets 4.6dp / 9.2dp (10.4% / 20.8%): see the widget_ring_* drawables -->
        <FrameLayout
            android:layout_width="44dp"
            android:layout_height="44dp">

            <ProgressBar
                android:id="@+id/widget_ring_steps"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:indeterminate="false"
                android:max="100"
                android:progressDrawable="@drawable/widget_ring_steps" />

            <ProgressBar
                android:id="@+id/widget_ring_distance"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_margin="4.6dp"
                android:indeterminate="false"
                android:max="100"
                android:progressDrawable="@drawable/widget_ring_distance" />

            <ProgressBar
                android:id="@+id/widget_ring_kcal"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_margin="9.2dp"
                android:indeterminate="false"
                android:max="100"
                android:progressDrawable="@drawable/widget_ring_kcal" />

            <ImageView
                android:id="@+id/widget_animal"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter" />

            <TextView
                android:id="@+id/widget_animal_emoji"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:textSize="11sp"
                android:visibility="gone" />
        </FrameLayout>

        <TextView
            android:id="@+id/widget_steps"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:maxLines="1"
            android:textColor="@color/widget_text_primary"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
