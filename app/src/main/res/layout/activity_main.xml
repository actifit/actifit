<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/content"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?android:attr/windowBackground">

    <!-- ================= HEADER SECTION ================= -->
    <RelativeLayout
        android:id="@+id/main_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp"
        android:background="?android:attr/windowBackground"
        android:elevation="4dp">

        <!-- Profile Picture -->
        <de.hdodenhof.circleimageview.CircleImageView
            android:id="@+id/user_profile_pic"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/actifit_logo"
            app:civ_border_width="0dp"
            android:layout_centerVertical="true"
            android:layout_alignParentStart="true" />

        <!-- User Info (Name & Rank) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_toEndOf="@id/user_profile_pic"
            android:layout_centerVertical="true"
            android:layout_marginStart="12dp"
            android:layout_toStartOf="@id/header_actions">

            <TextView
                android:id="@+id/welcome_user"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/actifitRed"
                android:textSize="18sp"
                android:textStyle="bold"
                tools:text="@string/welcome_user" />

            <LinearLayout
                android:id="@+id/rank_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/actifitRed"
                    android:fontFamily="@font/font_awesome_6_solid"
                    android:text="\uf091"
                    android:textSize="14sp"
                    android:layout_marginEnd="4dp" />

                <TextView
                    android:id="@+id/user_rank"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/color_text_secondary"
                    android:textSize="14sp"
                    tools:text="Rank 70" />
            </LinearLayout>
        </LinearLayout>

        <!-- Header Actions (Notifications, Settings) -->
        <!-- Kept "top_icons_container" ID to ensure compatibility if referenced -->
        <LinearLayout
            android:id="@+id/header_actions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            
            <!-- Login/Signup Container (Usually hidden if logged in) -->
             <LinearLayout
                android:id="@+id/login_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:visibility="gone"> <!-- Visibility managed by code -->
                <TextView android:id="@+id/signup_action"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/actifitRed"
                    android:textSize="16sp"
                    android:text="@string/signup"
                    android:padding="8dp"/>
                 <TextView android:id="@+id/separator"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/actifitRed"
                    android:text="|"
                    android:padding="0dp"/>
                <TextView android:id="@+id/login_action"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/actifitRed"
                    android:textSize="16sp"
                    android:text="@string/login"
                    android:padding="8dp"/>
            </LinearLayout>

            <GridLayout
                android:id="@+id/top_icons_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:columnCount="4"
                android:alignmentMode="alignBounds">

                <!-- Notifications -->
                <FrameLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="12dp">

                    <TextView
                        android:id="@+id/btn_view_notifications"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/actifitRed"
                        android:textSize="22sp"
                        android:text="\uf0f3"
                        android:fontFamily="@font/font_awesome_6_solid"
                        android:padding="8dp" />

                    <TextView
                        android:id="@+id/notif_count"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_gravity="top|end"
                        android:gravity="center"
                        android:textColor="@color/colorWhite"
                        android:textSize="10sp"
                        android:background="@drawable/badge_background"
                        android:backgroundTint="@color/actifitRed"
                        android:visibility="gone"
                        tools:text="1"
                        tools:visibility="visible" />
                </FrameLayout>

                <!-- Settings -->
                <TextView
                    android:id="@+id/btn_settings"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/actifitRed"
                    android:textSize="22sp"
                    android:text="\uf013"
                    android:fontFamily="@font/font_awesome_6_solid"
                    android:padding="8dp" />

                <!-- Logout (Hidden usually) -->
                <TextView android:id="@+id/logout_action"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/actifitRed"
                    android:textSize="22sp"
                    android:text="\uf2f5"
                     android:fontFamily="@font/font_awesome_6_solid"
                    android:visibility="gone"
                    android:padding="8dp"/>

            </GridLayout>
        </LinearLayout>
    </RelativeLayout>

    <!-- ================= SCROLLABLE CONTENT ================= -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/main_center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <!-- NEWS SLIDER -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/slider_background"
                android:layout_marginBottom="12dp">

                <androidx.viewpager.widget.ViewPager
                    android:id="@+id/news_pager"
                    android:layout_width="0dp"
                    android:layout_height="150dp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toTopOf="@id/news_tablayout"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <com.google.android.material.tabs.TabLayout
                    android:id="@+id/news_tablayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:tabBackground="@drawable/indicator_selector"
                    app:tabIndicatorHeight="0dp"
                    app:tabGravity="center" />
            </androidx.constraintlayout.widget.ConstraintLayout>
            
            <ImageView
                android:id="@+id/image_view"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                 android:layout_weight="0"
                android:visibility="gone" />


            <!-- ================= CARD 1: ACTIVITY HERO ================= -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:contentPadding="16dp"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/current_date"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/actifitRed"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:paddingBottom="8dp"
                        tools:text="December 18, 2025" />

                    <!-- Activity Container (Pie Charts) -->
                    <!-- Preserving relative layouts for logo overlays -->
                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="250dp">
                        
                         <!-- FITBIT -->
                         <RelativeLayout
                            android:id="@+id/third_party_active"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:visibility="gone">

                            <com.github.mikephil.charting.charts.PieChart
                                android:id="@+id/step_pie_chart_fitbit"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent" />

                            <ImageView
                                android:id="@+id/fitbit_logo"
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:src="@drawable/fitbit_app_icon"
                                android:layout_alignParentStart="true"
                                android:layout_alignParentTop="true"
                                android:layout_margin="8dp"/>

                            <TextView
                                android:id="@+id/sync"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/font_awesome_6_solid"
                                android:text="@string/fitbit_sync_btn"
                                android:textColor="@color/actifitRed"
                                android:textSize="24sp"
                                android:layout_alignTop="@id/step_pie_chart_fitbit"
                                android:layout_alignEnd="@id/step_pie_chart_fitbit"
                                android:padding="8dp"/>

                            <TextView
                                android:id="@+id/switchSettingsFitbit"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/actifitRed"
                                android:fontFamily="@font/font_awesome_6_solid"
                                android:textSize="24sp"
                                android:text="@string/switch_settings_btn"
                                android:layout_alignBottom="@+id/step_pie_chart_fitbit"
                                android:layout_alignEnd="@+id/step_pie_chart_fitbit"
                                android:padding="8dp"/>
                        </RelativeLayout>

                        <!-- HEALTH CONNECT -->
                        <RelativeLayout
                            android:id="@+id/health_connect_active"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:visibility="gone">

                            <com.github.mikephil.charting.charts.PieChart
                                android:id="@+id/step_pie_chart_health_connect"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent" />

                            <ImageView
                                android:id="@+id/health_connect_logo"
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:src="@mipmap/health_connect_logo" 
                                android:layout_alignParentStart="true"
                                android:layout_alignParentTop="true"
                                android:layout_margin="8dp"/>

                            <TextView
                                android:id="@+id/sync_health_connect"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignTop="@id/step_pie_chart_health_connect"
                                android:layout_alignEnd="@id/step_pie_chart_health_connect"
                                android:fontFamily="@font/font_awesome_6_solid"
                                android:text="@string/fitbit_sync_btn"
                                android:textColor="@color/actifitRed"
                                android:textSize="24sp" 
                                android:padding="8dp"/>

                            <TextView
                                android:id="@+id/switchSettingsHealthConnect"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignEnd="@+id/step_pie_chart_health_connect"
                                android:layout_alignBottom="@id/step_pie_chart_health_connect"
                                android:fontFamily="@font/font_awesome_6_solid"
                                android:text="@string/switch_settings_btn"
                                android:textColor="@color/actifitRed"
                                android:textSize="24sp"
                                android:padding="8dp"/>
                        </RelativeLayout>

                        <!-- DEVICE SENSORS (DEFAULT) -->
                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent">

                            <com.github.mikephil.charting.charts.PieChart
                                android:id="@+id/step_pie_chart"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent" />

                            <ImageView
                                android:id="@+id/sensor_tracking_logo"
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:src="@drawable/ic_smartphone"
                                android:layout_alignParentStart="true"
                                android:layout_alignParentTop="true"
                                android:layout_margin="8dp"
                                app:tint="@color/actifitRed"/>

                             <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:layout_alignBottom="@id/step_pie_chart"
                                android:layout_alignStart="@+id/step_pie_chart"
                                android:padding="8dp">

                                <TextView
                                    android:id="@+id/battery_notice"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textColor="@color/actifitRed"
                                    android:textSize="20sp"
                                    android:text="@string/fa_exclamation_circle_solid"
                                    android:fontFamily="@font/font_awesome_6_solid" />
                            </LinearLayout>

                            <TextView
                                android:id="@+id/switchSettings"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/actifitRed"
                                android:textSize="24sp"
                                android:padding="8dp"
                                android:text="@string/switch_settings_btn"
                                android:layout_alignBottom="@+id/step_pie_chart"
                                android:layout_alignEnd="@+id/step_pie_chart"
                                android:fontFamily="@font/font_awesome_6_solid" />
                        </RelativeLayout>
                    </FrameLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ================= CARD 2: SOCIAL & TRACKING ================= -->
             <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:contentPadding="16dp"
                android:layout_marginBottom="12dp">
                
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                     <LinearLayout
                        android:id="@+id/post_action_container"
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="12dp">

                        <androidx.appcompat.widget.AppCompatButton
                            style="@style/AppTheme.ActifitButton"
                            android:id="@+id/btn_post_steemit"
                            android:layout_width="0dp"
                            android:layout_height="50dp"
                            android:layout_weight="1"
                            android:layout_marginEnd="8dp"
                            android:text="@string/post_to_steem_btn_txt"
                            android:textSize="14sp" />

                        <Button
                            style="@style/AppTheme.ActifitButton"
                            android:id="@+id/btn_waves"
                            android:layout_width="50dp"
                            android:layout_height="50dp"
                            android:text="\uf086"
                            android:textSize="18sp"
                            android:fontFamily="@font/font_awesome_6_solid" />
                    </LinearLayout>
                    
                    <!-- Voting Status -->
                    <LinearLayout
                        android:id="@+id/voting_status_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="?attr/selectableItemBackground"
                        android:padding="8dp">

                        <TextView
                            android:id="@+id/voting_cycle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/font_awesome_6_solid"
                            android:textColor="@color/actifitRed"
                            android:text="\uf4b9"
                            android:textSize="20sp"
                            android:layout_marginEnd="8dp"/>

                        <TextView
                            android:id="@+id/voting_status_text"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textSize="14sp"
                            android:textColor="@color/color_text_secondary"
                            android:singleLine="true"
                            android:ellipsize="marquee"
                            android:scrollHorizontally="true"
                            tools:text="@string/rewards_processing"/>
                    </LinearLayout>
                </LinearLayout>

             </com.google.android.material.card.MaterialCardView>

            <!-- ================= CARD: USER STATUS (VP, RC, NEWBIE) ================= -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/user_status_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:contentPadding="16dp"
                android:layout_marginBottom="12dp"
                android:visibility="gone"
                tools:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Account Status"
                        android:textStyle="bold"
                        android:textSize="16sp"
                        android:textColor="@color/color_text_primary"
                        android:layout_marginBottom="12dp"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="8dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/font_awesome_6_solid"
                            android:textColor="@color/actifitRed"
                            android:text="\uf0e7"
                            android:textSize="20sp"
                            android:layout_marginEnd="8dp"/>

                        <TextView
                            android:id="@+id/voting_power"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="14sp"
                            android:textColor="@color/color_text_secondary"
                            tools:text="Voting Power: 100%"/>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/rc_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="8dp"
                        android:visibility="visible">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/font_awesome_6_solid"
                            android:textColor="@color/actifitRed"
                            android:text="\uf624"
                            android:textSize="20sp"
                            android:layout_marginEnd="8dp"/>

                        <TextView
                            android:id="@+id/account_rc"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="14sp"
                            android:textColor="@color/color_text_secondary"
                            tools:text="Resource Credits: 100%"/>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/newbie_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <TextView
                            android:id="@+id/verify_newbie"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/font_awesome_6_solid"
                            android:textColor="@color/actifitRed"
                            android:text="\uf2c1"
                            android:textSize="20sp"
                            android:layout_marginEnd="8dp"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="14sp"
                            android:textColor="@color/color_text_secondary"
                            android:text="Newbie Account (Verify)"/>
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ================= CARD 3: WALLET & EARNINGS ================= -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:contentPadding="16dp"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Wallet &amp; Earnings"
                        android:textStyle="bold"
                        android:textSize="16sp"
                        android:textColor="@color/color_text_primary"
                        android:layout_marginBottom="12dp"/>

                    <!-- Wallet Row -->
                    <LinearLayout
                        android:id="@+id/wallet_alt_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="12dp">
                        
                         <TextView
                            android:id="@+id/wallet_alt_btn"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:text="@string/fa_wallet_solid"
                            android:padding="4dp"
                            android:textSize="20sp"
                            android:textColor="@color/actifitRed"
                            android:fontFamily="@font/font_awesome_6_solid" />

                        <TextView
                            android:id="@+id/bal_display"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textSize="16sp"
                            android:textColor="@color/color_text_primary"
                            android:paddingStart="8dp"
                            android:singleLine="true"
                            tools:text="0 AFIT"/>

                         <TextView
                             android:id="@+id/btn_view_wallet"
                             android:layout_width="wrap_content"
                             android:layout_height="wrap_content"
                             android:text="VIEW"
                             android:textColor="@color/actifitRed"
                             android:textSize="14sp"
                             android:textStyle="bold"
                             android:background="?attr/selectableItemBackground"
                             android:padding="8dp"/>

                         <!-- Warning Icons -->
                         <TextView
                            android:id="@+id/token_notice_wallet"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/fa_exclamation_circle_solid"
                            android:textColor="@color/actifitRed"
                            android:textSize="18sp"
                            android:visibility="gone"
                            android:fontFamily="@font/font_awesome_6_solid"/>
                    </LinearLayout>

                    <View 
                        android:layout_width="match_parent" 
                        android:layout_height="1dp" 
                        android:background="#EEE"
                        android:layout_marginBottom="12dp"/>

                    <!-- Tokens & Badges -->
                    <LinearLayout
                        android:id="@+id/earnings_panel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:id="@+id/token_notice"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/actifitRed"
                            android:textSize="20sp"
                            android:text="@string/fa_exclamation_circle_solid"
                            android:fontFamily="@font/font_awesome_6_solid"
                            android:layout_marginEnd="8dp"/>

                        <ImageView
                            android:id="@+id/afit_logo"
                            android:src="@drawable/actifit_logo"
                            android:layout_height="24dp"
                            android:layout_width="24dp"
                            android:layout_marginEnd="8dp"/>
                         <ImageView
                            android:id="@+id/hive_logo"
                            android:src="@drawable/hive"
                            android:layout_height="24dp"
                            android:layout_width="24dp"
                            android:layout_marginEnd="8dp"/>
                        <ImageView
                            android:id="@+id/steem_logo"
                            android:src="@drawable/steem"
                            android:layout_height="24dp"
                            android:layout_width="24dp"
                             android:visibility="invisible"
                            android:layout_marginEnd="8dp"/>
                        <ImageView
                            android:id="@+id/blurt_logo"
                            android:src="@drawable/blurt"
                            android:layout_height="24dp"
                            android:layout_width="24dp"
                            android:layout_marginEnd="8dp"/>
                        <ImageView
                            android:id="@+id/sports_logo"
                            android:src="@drawable/sports"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_marginEnd="8dp"/>

                        <Space 
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"/>
                   </LinearLayout>

                    <!-- Gadgets Warning -->
                    <LinearLayout
                        android:id="@+id/missing_active_gadgets_container"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingTop="8dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/font_awesome_6_solid"
                            android:textColor="@color/actifitRed"
                            android:text="\uf54e"
                            android:textSize="18sp"
                            android:layout_marginEnd="8dp"/>
                        <TextView
                            android:id="@+id/missing_active_gadgets"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/no_active_gadgets_found"
                            android:textSize="12sp"
                            android:textColor="#CA0000"/>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/user_gadgets"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingTop="4dp">
                    </LinearLayout>


                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ================= CARD: RECENT TRANSACTIONS ================= -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/recent_transactions_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:contentPadding="16dp"
                android:layout_marginBottom="12dp"
                android:visibility="gone"
                tools:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Recent Transactions"
                            android:textStyle="bold"
                            android:textSize="16sp"
                            android:textColor="@color/color_text_primary"
                            android:layout_alignParentStart="true"
                            android:layout_centerVertical="true"/>

                        <TextView
                            android:id="@+id/btn_view_all_transactions"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="VIEW ALL"
                            android:textColor="@color/actifitRed"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:background="?attr/selectableItemBackground"
                            android:padding="8dp"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"/>
                    </RelativeLayout>

                    <LinearLayout
                        android:id="@+id/transactions_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">
                        <!-- Transactions will be added here dynamically -->
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ================= CARD 4: CHARTS ================= -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/history_card_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:contentPadding="16dp"
                android:layout_marginBottom="12dp">
                
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="8dp">
                        
                         <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Activity History"
                            android:textStyle="bold"
                            android:textSize="16sp"
                            android:textColor="@color/color_text_primary"/>

                        <!-- Chart Switcher -->
                        <LinearLayout
                            android:id="@+id/chart_switcher"
                             android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">
                            <Button
                                android:id="@+id/daily_chart_btn"
                                style="@style/Widget.AppCompat.Button.Small"
                                android:textColor="@color/actifitRed"
                                android:layout_width="wrap_content"
                                android:layout_height="36dp"
                                android:text="@string/daily"/>
                            <Button
                                android:id="@+id/hourly_chart_btn"
                                style="@style/Widget.AppCompat.Button.Small"
                                android:textColor="@color/actifitRed"
                                android:layout_width="wrap_content"
                                android:layout_height="36dp"
                                android:visibility="gone"
                                android:text="@string/hourly"/>
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/bar_chart_container"
                        android:layout_width="match_parent"
                        android:layout_height="150dp"
                        android:orientation="horizontal">

                        <com.github.mikephil.charting.charts.BarChart
                            android:id="@+id/main_today_activity_chart"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_weight="1"/>

                        <com.github.mikephil.charting.charts.BarChart
                            android:id="@+id/main_history_activity_chart"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:visibility="gone"/>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ================= CARD 5: EXTRAS ================= -->
             <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:contentPadding="16dp"
                android:layout_marginBottom="12dp">
                
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center">

                    <Button
                        style="@style/AppTheme.ActifitButton"
                        android:id="@+id/daily_reward"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="&#127873;"
                        android:textSize="20sp"
                        android:layout_marginEnd="8dp"/>

                    <Button
                        style="@style/AppTheme.ActifitButton"
                        android:id="@+id/refer_friend_button"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:textSize="20sp"
                        android:fontFamily="@font/font_awesome_6_solid"
                        android:text="\uf234"
                         android:layout_marginEnd="8dp"/>

                    <Button
                        style="@style/AppTheme.ActifitButton"
                        android:id="@+id/btn_buy_afit"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:textSize="20sp"
                        android:fontFamily="@font/font_awesome_6_solid"
                        android:text="\uf201"/>
                     
                     <Button
                        style="@style/AppTheme.ActifitButton"
                        android:id="@+id/launch_workout_wizard_button"
                        android:layout_width="0dp"
                         android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="\uf44b"
                        android:textSize="16sp"
                         android:layout_marginStart="8dp"
                        android:fontFamily="@font/font_awesome_6_solid"
                         tools:ignore="HardcodedText" />
                    
                    <FrameLayout
                        android:id="@+id/health_connect_status"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/button_background"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:padding="8dp"
                        android:elevation="2dp">
                        
                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:src="@mipmap/health_connect_logo"
                            android:scaleType="fitCenter"
                            android:contentDescription="Health Connect Status" />
                    </FrameLayout>

                </LinearLayout>
             </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>

    <include
        android:id="@+id/bottom_menu_container"
        layout="@layout/footer_menu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

</LinearLayout>