<?xml version="1.0" encoding="utf-8"?>
<!-- Steps widget. updatePeriodMillis (30 min, the platform minimum) covers the midnight rollover and
     "Open Actifit to sync" labels; live updates are pushed by WidgetUpdater. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/widget_description"
    android:initialLayout="@layout/widget_steps_small"
    android:minWidth="110dp"
    android:minHeight="110dp"
    android:minResizeWidth="110dp"
    android:minResizeHeight="110dp"
    android:previewImage="@mipmap/actifit_launcher"
    android:previewLayout="@layout/widget_steps_preview"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="2"
    android:targetCellHeight="2"
    android:updatePeriodMillis="1800000"
    android:widgetCategory="home_screen" />
