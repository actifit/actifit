<?xml version = "1.0" encoding = "utf-8"?>
<LinearLayout xmlns:android = "http://schemas.android.com/apk/res/android"
    android:layout_width = "match_parent"
    android:gravity = "center"
    android:layout_gravity="center"
    android:layout_height = "wrap_content"
    android:orientation="vertical"
    android:padding="10dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Connect with Actifit"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/actifitRed"
        android:layout_marginBottom="12dp" />

    <GridLayout
        xmlns:android = "http://schemas.android.com/apk/res/android"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:rowCount="3"
        android:columnCount="3"
        android:horizontalSpacing="8dp"
        android:verticalSpacing="8dp"
        >

    <Button
        style="@style/AppTheme.ActifitButton"
        android:id="@+id/facebook_actifit"
        android:layout_width="60dp"
        android:layout_height="48dp"
        android:textSize="20sp"
        android:fontFamily="@font/font_awesome_6_brands"
        android:text="\uf09a"
        android:padding="0dp"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:insetLeft="0dp"
        android:insetTop="0dp"
        android:insetRight="0dp"
        android:insetBottom="0dp"
        />

    <Button
        style="@style/AppTheme.ActifitButton"
        android:id="@+id/twitter_actifit"
        android:layout_width="60dp"
        android:layout_height="48dp"
        android:textSize="20sp"
        android:fontFamily="@font/font_awesome_6_brands"
        android:text="\uf099"
        android:padding="0dp"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:insetLeft="0dp"
        android:insetTop="0dp"
        android:insetRight="0dp"
        android:insetBottom="0dp"
        />

    <Button
        style="@style/AppTheme.ActifitButton"
        android:id="@+id/discord_actifit"
        android:layout_width="60dp"
        android:layout_height="48dp"
        android:textSize="20sp"
        android:fontFamily="@font/font_awesome_6_brands"
        android:text="\uf392"
        android:padding="0dp"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:insetLeft="0dp"
        android:insetTop="0dp"
        android:insetRight="0dp"
        android:insetBottom="0dp"
        />

    <Button
        style="@style/AppTheme.ActifitButton"
        android:id="@+id/telegram_actifit"
        android:layout_width="60dp"
        android:layout_height="48dp"
        android:textSize="20sp"
        android:fontFamily="@font/font_awesome_6_brands"
        android:text="\uf2c6"
        android:padding="0dp"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:insetLeft="0dp"
        android:insetTop="0dp"
        android:insetRight="0dp"
        android:insetBottom="0dp"
        />

    <Button
        style="@style/AppTheme.ActifitButton"
        android:id="@+id/youtube_actifit"
        android:layout_width="60dp"
        android:layout_height="48dp"
        android:textSize="20sp"
        android:fontFamily="@font/font_awesome_6_brands"
        android:text="\uf167"
        android:padding="0dp"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:insetLeft="0dp"
        android:insetTop="0dp"
        android:insetRight="0dp"
        android:insetBottom="0dp"
        />

    <Button
        style="@style/AppTheme.ActifitButton"
        android:id="@+id/instagram_actifit"
        android:layout_width="60dp"
        android:layout_height="48dp"
        android:textSize="20sp"
        android:fontFamily="@font/font_awesome_6_brands"
        android:text="\uf16d"
        android:padding="0dp"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:insetLeft="0dp"
        android:insetTop="0dp"
        android:insetRight="0dp"
        android:insetBottom="0dp"
        />


    <!--<Button
        style="@style/AppTheme.ActifitButton"
        android:id="@+id/medium_actifit"
        android:layout_width="70dp"
        android:layout_height="wrap_content"
        android:textSize="20dp"
        android:fontFamily="@font/font_awesome_6_brands"
        android:text="\u"
        />-->


    <Button
        style="@style/AppTheme.ActifitButton"
        android:id="@+id/linkedin_actifit"
        android:layout_width="60dp"
        android:layout_height="48dp"
        android:textSize="20sp"
        android:fontFamily="@font/font_awesome_6_brands"
        android:text="\uf08c"
        android:padding="0dp"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:insetLeft="0dp"
        android:insetTop="0dp"
        android:insetRight="0dp"
        android:insetBottom="0dp"
        />

    </GridLayout>

</LinearLayout>