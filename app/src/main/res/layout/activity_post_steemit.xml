<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:orientation="vertical"
        android:layout_height="match_parent"
        android:layout_width="match_parent"
        android:id="@+id/post_steemit_container"
        android:background="?android:attr/windowBackground">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/nestedScrollView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:overScrollMode="never">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="60dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_md"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">

                <!-- Title Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/spacing_md"
                    app:cardCornerRadius="@dimen/card_corner_radius"
                    app:cardElevation="@dimen/card_elevation"
                    app:cardBackgroundColor="@color/md_theme_cardBackground">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/spacing_md">

                        <TextView
                            android:id="@+id/steemit_post_title_lbl"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/report_title"
                            android:textSize="@dimen/text_subtitle"
                            android:textStyle="bold"
                            android:textColor="@color/md_theme_onSurface"
                            android:layout_marginBottom="@dimen/spacing_sm" />

                        <EditText
                            android:id="@+id/steemit_post_title"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ems="10"
                            android:background="@drawable/input_background"
                            android:padding="@dimen/spacing_md"
                            android:inputType="textCapSentences"
                            android:maxLines="2"
                            android:textColor="@color/md_theme_onSurface"
                            android:textSize="@dimen/text_subtitle" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Full AFIT Pay (hidden, for compatibility) -->
                <TextView
                    android:id="@+id/full_afit_pay_lbl"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/full_report_AFIT_pay"
                    android:visibility="gone" />

                <CheckBox
                    android:id="@+id/full_afit_pay"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/full_AFIT_checkbox" />

                <!-- Date & Steps Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_date_steps"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/spacing_md"
                    app:cardCornerRadius="@dimen/card_corner_radius"
                    app:cardElevation="@dimen/card_elevation"
                    app:cardBackgroundColor="@color/md_theme_cardBackground">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/spacing_md">

                        <!-- Date Section -->
                        <TextView
                            android:id="@+id/report_date_option_group_title"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/report_date_option_group_title"
                            android:textSize="@dimen/text_subtitle"
                            android:textStyle="bold"
                            android:textColor="@color/md_theme_onSurface"
                            android:layout_marginBottom="@dimen/spacing_sm" />

                        <com.google.android.material.button.MaterialButtonToggleGroup
                            android:id="@+id/report_date_option_group"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="@dimen/spacing_md"
                            app:singleSelection="true"
                            app:selectionRequired="true">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/report_today_option"
                                style="@style/AppTheme.ActifitButton.Outlined"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/today_report_option" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/report_yesterday_option"
                                style="@style/AppTheme.ActifitButton.Outlined"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/yesterday_report_option" />
                        </com.google.android.material.button.MaterialButtonToggleGroup>

                        <!-- Steps Section -->
                        <TextView
                            android:id="@+id/steemit_step_count_lbl"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/activity_count_lbl"
                            android:textSize="@dimen/text_subtitle"
                            android:textStyle="bold"
                            android:textColor="@color/md_theme_onSurface"
                            android:layout_marginBottom="@dimen/spacing_sm" />

                        <LinearLayout
                            android:id="@+id/activity_data_section"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical">

                                <EditText
                                    android:id="@+id/steemit_step_count"
                                    android:layout_width="100dp"
                                    android:layout_height="wrap_content"
                                    android:enabled="false"
                                    android:inputType="textMultiLine"
                                    android:background="@drawable/input_background"
                                    android:padding="@dimen/spacing_md"
                                    android:textColor="@color/md_theme_onSurface"
                                    android:textSize="@dimen/text_subtitle" />

                                <Button
                                    style="@style/AppTheme.ActifitButton"
                                    android:id="@+id/sync_data"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="@dimen/spacing_sm"
                                    android:text="@string/sync_data_btn_lbl" />
                            </LinearLayout>

                            <TextView
                                android:id="@+id/fitbit_sync_notice"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/spacing_xs"
                                android:text="@string/fitbit_sync_again_notice"
                                android:textColor="@color/md_theme_error"
                                android:textStyle="bold"
                                android:visibility="gone" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Activity Type Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_activity_type"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/spacing_md"
                    app:cardCornerRadius="@dimen/card_corner_radius"
                    app:cardElevation="@dimen/card_elevation"
                    app:cardBackgroundColor="@color/md_theme_cardBackground">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/spacing_md">

                        <TextView
                            android:id="@+id/steemit_activity_type_lbl"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/activity_type_lbl"
                            android:textSize="@dimen/text_subtitle"
                            android:textStyle="bold"
                            android:textColor="@color/md_theme_onSurface"
                            android:layout_marginBottom="@dimen/spacing_sm" />

                        <com.google.android.material.chip.ChipGroup
                            android:id="@+id/activity_chip_group"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_sm"
                            app:chipSpacingHorizontal="@dimen/spacing_xs"
                            app:chipSpacingVertical="@dimen/spacing_xs" />

                        <com.google.android.material.chip.ChipGroup
                            android:id="@+id/activity_chip_group_more"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:visibility="gone"
                            app:chipSpacingHorizontal="@dimen/spacing_xs"
                            app:chipSpacingVertical="@dimen/spacing_xs" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_show_more_activities"
                            style="@style/AppTheme.ActifitButton.Text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_xs"
                            android:text="@string/show_more_activities" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Measurements Card (Collapsible) -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_measurements"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/spacing_md"
                    app:cardCornerRadius="@dimen/card_corner_radius"
                    app:cardElevation="@dimen/card_elevation"
                    app:cardBackgroundColor="@color/md_theme_cardBackground">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/spacing_md">

                        <!-- Clickable header with chevron -->
                        <LinearLayout
                            android:id="@+id/measurements_header"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:clickable="true"
                            android:focusable="true"
                            android:background="?android:attr/selectableItemBackground">

                            <TextView
                                android:id="@+id/measurements_section_lbl"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/track_measurements_lbl"
                                android:textSize="@dimen/text_subtitle"
                                android:textStyle="bold"
                                android:textColor="@color/md_theme_onSurface"
                                android:paddingTop="@dimen/spacing_xs"
                                android:paddingBottom="@dimen/spacing_xs" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/measurements_chevron"
                                style="@style/AppTheme.ToolbarIconButton"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/font_awesome_6_solid"
                                android:text="" />
                        </LinearLayout>

                        <!-- Collapsible measurements content -->
                        <LinearLayout
                            android:id="@+id/measurements_content"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:visibility="gone"
                            android:paddingTop="@dimen/spacing_sm">

                            <!-- Height -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical">
                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_weight="1"
                                    android:layout_height="wrap_content"
                                    android:text="@string/height_lbl"
                                    android:textStyle="bold"
                                    android:textColor="@color/md_theme_textSecondary"
                                    android:textSize="@dimen/text_body" />
                                <TextView
                                    android:id="@+id/measurements_height_value"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="&#8212;"
                                    android:textColor="@color/actifitRed"
                                    android:textStyle="bold"
                                    android:textSize="@dimen/text_body" />
                                <TextView
                                    android:id="@+id/measurements_height_unit"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/unit_lbl"
                                    android:paddingStart="@dimen/spacing_xs"
                                    android:textColor="@color/md_theme_textSecondary"
                                    android:textSize="@dimen/text_body" />
                            </LinearLayout>
                            <com.google.android.material.slider.Slider
                                android:id="@+id/measurements_height"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="@dimen/spacing_md"
                                app:thumbColor="@color/actifitRed"
                                app:trackColorActive="@color/actifitRed"
                                app:haloColor="@color/actifitRed"
                                app:labelBehavior="floating" />

                            <!-- Weight -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical">
                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_weight="1"
                                    android:layout_height="wrap_content"
                                    android:text="@string/weight_lbl"
                                    android:textStyle="bold"
                                    android:textColor="@color/md_theme_textSecondary"
                                    android:textSize="@dimen/text_body" />
                                <TextView
                                    android:id="@+id/measurements_weight_value"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="&#8212;"
                                    android:textColor="@color/actifitRed"
                                    android:textStyle="bold"
                                    android:textSize="@dimen/text_body" />
                                <TextView
                                    android:id="@+id/measurements_weight_unit"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/unit_lbl"
                                    android:paddingStart="@dimen/spacing_xs"
                                    android:textColor="@color/md_theme_textSecondary"
                                    android:textSize="@dimen/text_body" />
                            </LinearLayout>
                            <com.google.android.material.slider.Slider
                                android:id="@+id/measurements_weight"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="@dimen/spacing_md"
                                app:thumbColor="@color/actifitRed"
                                app:trackColorActive="@color/actifitRed"
                                app:haloColor="@color/actifitRed"
                                app:labelBehavior="floating" />

                            <!-- Body Fat -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical">
                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_weight="1"
                                    android:layout_height="wrap_content"
                                    android:text="@string/body_fat_lbl"
                                    android:textStyle="bold"
                                    android:textColor="@color/md_theme_textSecondary"
                                    android:textSize="@dimen/text_body" />
                                <TextView
                                    android:id="@+id/measurements_bodyfat_value"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="&#8212;"
                                    android:textColor="@color/actifitRed"
                                    android:textStyle="bold"
                                    android:textSize="@dimen/text_body" />
                                <TextView
                                    android:id="@+id/measurements_bodyfat_unit"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/percent_lbl"
                                    android:paddingStart="@dimen/spacing_xs"
                                    android:textColor="@color/md_theme_textSecondary"
                                    android:textSize="@dimen/text_body" />
                            </LinearLayout>
                            <com.google.android.material.slider.Slider
                                android:id="@+id/measurements_bodyfat"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="@dimen/spacing_md"
                                app:thumbColor="@color/actifitRed"
                                app:trackColorActive="@color/actifitRed"
                                app:haloColor="@color/actifitRed"
                                app:labelBehavior="floating" />

                            <!-- Waist -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical">
                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_weight="1"
                                    android:layout_height="wrap_content"
                                    android:text="@string/waist_size_lbl"
                                    android:textStyle="bold"
                                    android:textColor="@color/md_theme_textSecondary"
                                    android:textSize="@dimen/text_body" />
                                <TextView
                                    android:id="@+id/measurements_waistsize_value"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="&#8212;"
                                    android:textColor="@color/actifitRed"
                                    android:textStyle="bold"
                                    android:textSize="@dimen/text_body" />
                                <TextView
                                    android:id="@+id/measurements_waistsize_unit"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/unit_lbl"
                                    android:paddingStart="@dimen/spacing_xs"
                                    android:textColor="@color/md_theme_textSecondary"
                                    android:textSize="@dimen/text_body" />
                            </LinearLayout>
                            <com.google.android.material.slider.Slider
                                android:id="@+id/measurements_waistsize"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="@dimen/spacing_md"
                                app:thumbColor="@color/actifitRed"
                                app:trackColorActive="@color/actifitRed"
                                app:haloColor="@color/actifitRed"
                                app:labelBehavior="floating" />

                            <!-- Thighs -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical">
                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_weight="1"
                                    android:layout_height="wrap_content"
                                    android:text="@string/thighs_size_lbl"
                                    android:textStyle="bold"
                                    android:textColor="@color/md_theme_textSecondary"
                                    android:textSize="@dimen/text_body" />
                                <TextView
                                    android:id="@+id/measurements_thighs_value"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="&#8212;"
                                    android:textColor="@color/actifitRed"
                                    android:textStyle="bold"
                                    android:textSize="@dimen/text_body" />
                                <TextView
                                    android:id="@+id/measurements_thighs_unit"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/unit_lbl"
                                    android:paddingStart="@dimen/spacing_xs"
                                    android:textColor="@color/md_theme_textSecondary"
                                    android:textSize="@dimen/text_body" />
                            </LinearLayout>
                            <com.google.android.material.slider.Slider
                                android:id="@+id/measurements_thighs"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="@dimen/spacing_md"
                                app:thumbColor="@color/actifitRed"
                                app:trackColorActive="@color/actifitRed"
                                app:haloColor="@color/actifitRed"
                                app:labelBehavior="floating" />

                            <!-- Chest -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical">
                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_weight="1"
                                    android:layout_height="wrap_content"
                                    android:text="@string/chest_size_lbl"
                                    android:textStyle="bold"
                                    android:textColor="@color/md_theme_textSecondary"
                                    android:textSize="@dimen/text_body" />
                                <TextView
                                    android:id="@+id/measurements_chest_value"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="&#8212;"
                                    android:textColor="@color/actifitRed"
                                    android:textStyle="bold"
                                    android:textSize="@dimen/text_body" />
                                <TextView
                                    android:id="@+id/measurements_chest_unit"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/unit_lbl"
                                    android:paddingStart="@dimen/spacing_xs"
                                    android:textColor="@color/md_theme_textSecondary"
                                    android:textSize="@dimen/text_body" />
                            </LinearLayout>
                            <com.google.android.material.slider.Slider
                                android:id="@+id/measurements_chest"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="@dimen/spacing_xs"
                                app:thumbColor="@color/actifitRed"
                                app:trackColorActive="@color/actifitRed"
                                app:haloColor="@color/actifitRed"
                                app:labelBehavior="floating" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Tags Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_tags"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/spacing_md"
                    app:cardCornerRadius="@dimen/card_corner_radius"
                    app:cardElevation="@dimen/card_elevation"
                    app:cardBackgroundColor="@color/md_theme_cardBackground">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/spacing_md">

                        <TextView
                            android:id="@+id/steemit_post_tags_lbl"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/report_tags_lbl"
                            android:textSize="@dimen/text_subtitle"
                            android:textStyle="bold"
                            android:textColor="@color/md_theme_onSurface"
                            android:layout_marginBottom="@dimen/spacing_sm" />

                        <com.google.android.material.chip.ChipGroup
                            android:id="@+id/tags_chip_group"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="@dimen/spacing_xs"
                            app:chipSpacingHorizontal="@dimen/spacing_xs"
                            app:chipSpacingVertical="@dimen/spacing_xs" />

                        <EditText
                            android:id="@+id/steemit_post_tags"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@drawable/input_background"
                            android:padding="@dimen/spacing_md"
                            android:inputType="text"
                            android:imeOptions="actionDone"
                            android:maxLines="1"
                            android:hint="@string/add_tag_hint"
                            android:textColor="@color/md_theme_onSurface"
                            android:textSize="@dimen/text_subtitle" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Content Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/spacing_md"
                    app:cardCornerRadius="@dimen/card_corner_radius"
                    app:cardElevation="@dimen/card_elevation"
                    app:cardBackgroundColor="@color/md_theme_cardBackground">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/spacing_md">

                        <TextView
                            android:id="@+id/steemit_post_content_lbl"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/report_content_lbl"
                            android:textSize="@dimen/text_subtitle"
                            android:textStyle="bold"
                            android:textColor="@color/md_theme_onSurface"
                            android:layout_marginBottom="@dimen/spacing_sm" />

                        <TextView
                            android:id="@+id/steemit_post_content_note"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/markdown_content_note"
                            android:textStyle="italic"
                            android:textColor="@color/md_theme_textSecondary"
                            android:textSize="@dimen/text_body"
                            android:layout_marginBottom="@dimen/spacing_sm" />

                        <!-- Toolbar -->
                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="@dimen/spacing_sm"
                            app:cardCornerRadius="@dimen/card_corner_radius"
                            app:cardElevation="0dp"
                            app:strokeColor="@color/md_theme_separator"
                            app:strokeWidth="1dp"
                            app:cardBackgroundColor="@color/md_theme_cardBackground">

                            <LinearLayout
                                android:id="@+id/btn_container"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical"
                                android:padding="@dimen/spacing_sm">

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btn_choose_file"
                                    style="@style/AppTheme.ToolbarIconButton"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/font_awesome_6_regular"
                                    android:text="  Image" />

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btn_video_post"
                                    style="@style/AppTheme.ToolbarIconButton"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/font_awesome_6_solid"
                                    android:text="  Video" />

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btn_expand_editor"
                                    style="@style/AppTheme.ToolbarIconButton"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:contentDescription="Expand Editor"
                                    android:fontFamily="@font/font_awesome_6_solid"
                                    android:text="  Expand" />
                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btn_ai_suggest"
                                    style="@style/AppTheme.ToolbarIconButton"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:contentDescription="AI Assistant"
                                    app:icon="@drawable/ic_ai_sparkle"
                                    app:iconTint="@color/actifitRed"
                                    app:iconGravity="textStart"
                                    app:iconPadding="0dp"
                                    android:insetLeft="0dp"
                                    android:insetRight="0dp"
                                    android:text="" />

                                <View
                                    android:layout_width="0dp"
                                    android:layout_height="1dp"
                                    android:layout_weight="1" />

                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:orientation="horizontal"
                                    android:gravity="center_vertical"
                                    android:paddingEnd="@dimen/spacing_xs">

                                    <TextView
                                        android:id="@+id/charCount"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="0"
                                        android:textColor="@color/md_theme_textSecondary"
                                        android:textSize="@dimen/text_body" />

                                    <TextView
                                        android:id="@+id/minCharCount"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="/100"
                                        android:textColor="@color/md_theme_textSecondary"
                                        android:textSize="@dimen/text_body" />

                                    <TextView
                                        android:id="@+id/charInfo"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:fontFamily="@font/font_awesome_6_solid"
                                        android:textColor="@color/md_theme_error"
                                        android:text="\uf05a"
                                        android:textSize="@dimen/text_subtitle"
                                        android:paddingStart="@dimen/spacing_xs" />
                                </LinearLayout>
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>

                        <com.google.android.material.progressindicator.LinearProgressIndicator
                            android:id="@+id/content_progress_bar"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="@dimen/spacing_sm"
                            android:max="100"
                            android:progress="0"
                            app:indicatorColor="@color/actifitRed"
                            app:trackColor="@color/md_theme_separator"
                            app:trackThickness="3dp"
                            app:trackCornerRadius="2dp" />

                        <!-- Editor -->
                        <EditText
                            android:id="@+id/steemit_post_text"
                            android:layout_width="match_parent"
                            android:layout_height="185dp"
                            android:ems="10"
                            android:gravity="top"
                            android:inputType="textCapSentences|textMultiLine|textAutoCorrect"
                            android:hint="@string/report_text_hint_1"
                            android:background="@drawable/input_background"
                            android:padding="@dimen/spacing_md"
                            android:textColor="@color/md_theme_onSurface"
                            android:textSize="@dimen/text_subtitle"
                            android:scrollbars="vertical"
                            android:overScrollMode="ifContentScrolls"
                            android:focusableInTouchMode="true" />

                        <!-- Preview -->
                        <TextView
                            android:id="@+id/steemit_post_preview_lbl"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/report_preview_lbl"
                            android:textSize="@dimen/text_subtitle"
                            android:textStyle="bold"
                            android:textColor="@color/md_theme_onSurface"
                            android:layout_marginTop="@dimen/spacing_md"
                            android:layout_marginBottom="@dimen/spacing_sm" />

                        <TextView
                            android:id="@+id/md_view"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="@dimen/spacing_lg"
                            android:minHeight="185dp"
                            android:padding="@dimen/spacing_md"
                            android:background="@drawable/input_background"
                            android:textColor="@color/md_theme_onSurface" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                </LinearLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.core.widget.NestedScrollView>

        <include
            android:id="@+id/bottom_menu_container"
            layout="@layout/footer_menu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </LinearLayout>


    <!-- FAB Post Button -->
    <Button
        android:id="@+id/post_to_steem_btn"
        style="@style/AppTheme.ActifitButton"
        android:layout_width="wrap_content"
        android:text="@string/post"
        android:textSize="@dimen/text_body"
        android:layout_height="wrap_content"
        android:layout_gravity="end|bottom"
        android:layout_marginEnd="@dimen/spacing_lg"
        android:layout_marginBottom="64dp"
        android:clickable="true"
        android:focusable="true"
        app:cornerRadius="@dimen/pill_corner_radius" />

</FrameLayout>
