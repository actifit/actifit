<?xml version="1.0" encoding="utf-8"?>
<!-- Steps widget, medium (wide): header (logo, "Actifit", avatar); bigger rings around the companion
     with a stats column: steps, "x / goal", and one dot row per ring; streak / status footer.
     Texts are set by WidgetUpdater so they follow the in-app language. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="@dimen/widget_padding">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="20dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:importantForAccessibility="no"
            android:src="@drawable/actifit_logo" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:layout_weight="1"
            android:maxLines="1"
            android:text="@string/widget_brand"
            android:textColor="@color/widget_accent"
            android:textSize="12sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/widget_avatar"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- rings 72dp, insets 7.5dp / 15dp (10.4% / 20.8%): see the widget_ring_* drawables -->
        <FrameLayout
            android:layout_width="72dp"
            android:layout_height="72dp">

            <ProgressBar
                android:id="@+id/widget_ring_steps"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:indeterminate="false"
                android:max="100"
                android:progressDrawable="@drawable/widget_ring_steps" />

            <ProgressBar
                android:id="@+id/widget_ring_distance"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_margin="7.5dp"
                android:indeterminate="false"
                android:max="100"
                android:progressDrawable="@drawable/widget_ring_distance" />

            <ProgressBar
                android:id="@+id/widget_ring_kcal"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_margin="15dp"
                android:indeterminate="false"
                android:max="100"
                android:progressDrawable="@drawable/widget_ring_kcal" />

            <ImageView
                android:id="@+id/widget_animal"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter" />

            <TextView
                android:id="@+id/widget_animal_emoji"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:textSize="19sp"
                android:visibility="gone" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_steps"
                android:layout_width="match_parent"
                android:layout_height="24dp"
                android:autoSizeMaxTextSize="20sp"
                android:autoSizeMinTextSize="12sp"
                android:autoSizeTextType="uniform"
                android:gravity="center_vertical|start"
                android:maxLines="1"
                android:textColor="@color/widget_text_primary"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_goal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/widget_text_secondary"
                android:textSize="11sp" />

            <LinearLayout
                android:id="@+id/widget_row_steps_line"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/widget_dot_steps"
                    android:layout_width="7dp"
                    android:layout_height="7dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/widget_dot_steps" />

                <TextView
                    android:id="@+id/widget_row_steps"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/widget_text_primary"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/widget_row_distance_line"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/widget_dot_distance"
                    android:layout_width="7dp"
                    android:layout_height="7dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/widget_dot_distance" />

                <TextView
                    android:id="@+id/widget_row_distance"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/widget_text_primary"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/widget_row_kcal_line"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/widget_dot_kcal"
                    android:layout_width="7dp"
                    android:layout_height="7dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/widget_dot_kcal" />

                <TextView
                    android:id="@+id/widget_row_kcal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/widget_text_primary"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- replaces the distance and kcal rows when the user must act but the footer has no room -->
            <TextView
                android:id="@+id/widget_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="@color/widget_accent"
                android:textSize="11sp"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <!-- streak, or the sync / login state first when the user must act; dropped when short -->
    <TextView
        android:id="@+id/widget_footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/widget_text_secondary"
        android:textSize="11sp" />
</LinearLayout>
