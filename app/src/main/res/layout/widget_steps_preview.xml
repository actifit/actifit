<?xml version="1.0" encoding="utf-8"?>
<!-- Widget picker preview (Android 12+): the small layout with static sample values. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:padding="4dp">

    <ImageView
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_gravity="top|start"
        android:layout_margin="4dp"
        android:importantForAccessibility="no"
        android:src="@drawable/actifit_logo" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="80dp"
            android:layout_height="80dp">

            <ProgressBar
                android:id="@+id/widget_ring_steps"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:indeterminate="false"
                android:max="100"
                android:progress="62"
                android:progressDrawable="@drawable/widget_ring_steps" />

            <ProgressBar
                android:id="@+id/widget_ring_distance"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_margin="8dp"
                android:indeterminate="false"
                android:max="100"
                android:progress="59"
                android:progressDrawable="@drawable/widget_ring_distance" />

            <ProgressBar
                android:id="@+id/widget_ring_kcal"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_margin="17dp"
                android:indeterminate="false"
                android:max="100"
                android:progress="50"
                android:progressDrawable="@drawable/widget_ring_kcal" />

            <TextView
                android:id="@+id/widget_animal_emoji"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:text="&#x1F43A;"
                android:textSize="18sp" />
        </FrameLayout>

        <TextView
            android:id="@+id/widget_steps"
            android:layout_width="match_parent"
            android:layout_height="20dp"
            android:gravity="center"
            android:maxLines="1"
            android:text="6,240"
            android:textColor="@color/widget_text_primary"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>
</FrameLayout>
