<?xml version="1.0" encoding="utf-8"?>
<!-- Video sheet: upload a video to 3Speak and pick one for the report (VideoUploadFragment). -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/vid_bg_sheet">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="10dp"
        android:paddingEnd="20dp"
        android:paddingBottom="24dp">

        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/vid_bg_handle" />

        <!-- header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="top"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/vids_sheet_title"
                    android:textColor="@color/vid_text"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/vidsSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/vid_text_secondary"
                    android:textSize="13sp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/refresh_list"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/vid_bg_round_soft"
                android:contentDescription="@string/vids_refresh"
                android:src="@drawable/vid_ic_refresh"
                app:tint="#3A3638" />

            <ImageButton
                android:id="@+id/closeButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/vid_bg_round_soft"
                android:contentDescription="@string/close_button"
                android:src="@drawable/vid_ic_close"
                app:tint="#3A3638" />
        </LinearLayout>

        <!-- upload in progress -->
        <LinearLayout
            android:id="@+id/uploadCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/vid_bg_upload_card"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/uploadFrame"
                    android:layout_width="64dp"
                    android:layout_height="88dp"
                    android:background="@drawable/vid_bg_thumb"
                    android:importantForAccessibility="no"
                    android:scaleType="centerCrop" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/vid_uploading_title"
                        android:textColor="@color/vid_text"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/uploadMeta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="@color/vid_text_secondary"
                        android:textSize="13sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/vid_uploading_note"
                        android:textColor="@color/vid_text_secondary"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/uploadProgress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:indeterminate="true"
                android:max="100"
                app:indicatorColor="@color/vid_red"
                app:trackColor="@color/vid_card_stroke"
                app:trackCornerRadius="4dp"
                app:trackThickness="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/uploadBytes"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/vid_chip_grey_fg"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/uploadPct"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/vid_chip_grey_fg"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- upload actions -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/vidSelector"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:backgroundTint="@color/vid_red"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="@string/vids_from_gallery"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                app:cornerRadius="16dp"
                app:icon="@drawable/vid_ic_gallery"
                app:iconGravity="textStart"
                app:iconSize="20dp"
                app:iconTint="#FFFFFF" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/recordVideo"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="@string/vids_record"
                android:textAllCaps="false"
                android:textColor="@color/vid_red_text"
                android:textSize="15sp"
                app:cornerRadius="16dp"
                app:icon="@drawable/vid_ic_record"
                app:iconGravity="textStart"
                app:iconSize="20dp"
                app:iconTint="@color/vid_red_text"
                app:strokeColor="@color/vid_red"
                app:strokeWidth="1.5dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/oneAtATime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="@string/vid_one_at_a_time"
            android:textColor="@color/vid_text_secondary"
            android:textSize="12sp"
            android:visibility="gone" />

        <!-- first time: no uploads yet -->
        <LinearLayout
            android:id="@+id/emptyState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:visibility="gone">

            <FrameLayout
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:background="@drawable/vid_bg_empty_icon">

                <ImageView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/vid_ic_record"
                    app:tint="@color/vid_red_text" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/vids_empty_title"
                android:textColor="@color/vid_text"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:lineSpacingMultiplier="1.2"
                android:text="@string/vids_empty_body"
                android:textColor="@color/vid_chip_grey_fg"
                android:textSize="15sp" />

            <TextView
                style="@style/VidTip"
                android:layout_marginTop="16dp"
                android:text="@string/vids_tip_short" />

            <TextView
                style="@style/VidTip"
                android:text="@string/vids_tip_processing" />

            <TextView
                style="@style/VidTip"
                android:text="@string/vids_tip_one_report" />
        </LinearLayout>

        <!-- recent uploads -->
        <TextView
            android:id="@+id/recentLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:letterSpacing="0.06"
            android:text="@string/vids_recent"
            android:textAllCaps="true"
            android:textColor="@color/vid_text_secondary"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/loader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="24dp"
            android:indeterminate="true"
            android:visibility="gone"
            app:indicatorColor="@color/vid_red"
            app:indicatorSize="32dp" />

        <LinearLayout
            android:id="@+id/vidsList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:divider="@drawable/vid_divider"
            android:orientation="vertical"
            android:showDividers="middle" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
