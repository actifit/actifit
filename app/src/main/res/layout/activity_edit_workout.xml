<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:colorBackground"
    tools:context=".EditWorkoutActivity">

    <ScrollView
        android:id="@+id/editWorkoutScrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:paddingTop="16dp"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:paddingBottom="4dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottom_menu_container">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/edit_workout_title"
                android:textColor="@color/actifitRed"
                android:textAppearance="@style/TextAppearance.AppCompat.Title"
                android:layout_marginBottom="16dp"
                android:gravity="center_horizontal"/>

            <!-- Workout Name -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/workout_name"
                android:textAppearance="@style/TextAppearance.AppCompat.Medium"
                android:textColor="?android:attr/textColorPrimary"
                android:layout_marginBottom="4dp"/>
            <EditText
                android:id="@+id/editWorkoutNameEditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/edit_workout_name_hint"
                android:inputType="textCapWords"
                android:minHeight="48dp"
                android:layout_marginBottom="16dp"
                android:background="?android:attr/editTextBackground"
                android:textColor="?android:attr/textColorPrimary"
                android:textColorHint="?android:attr/textColorHint"/>

            <!-- Description -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/edit_workout_description_hint"
                android:textAppearance="@style/TextAppearance.AppCompat.Medium"
                android:textColor="?android:attr/textColorPrimary"
                android:layout_marginBottom="4dp"/>
            <EditText
                android:id="@+id/editWorkoutDescriptionEditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/edit_workout_description_hint"
                android:inputType="textMultiLine"
                android:minLines="3"
                android:maxLines="5"
                android:gravity="top|start"
                android:layout_marginBottom="16dp"
                android:background="?android:attr/editTextBackground"
                android:textColor="?android:attr/textColorPrimary"
                android:textColorHint="?android:attr/textColorHint"/>

            <!-- Explanation -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/edit_workout_explanation_hint"
                android:textAppearance="@style/TextAppearance.AppCompat.Medium"
                android:textColor="?android:attr/textColorPrimary"
                android:layout_marginBottom="4dp"/>
            <EditText
                android:id="@+id/editWorkoutExplanationEditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/edit_workout_explanation_hint"
                android:inputType="textMultiLine"
                android:minLines="3"
                android:maxLines="5"
                android:gravity="top|start"
                android:layout_marginBottom="24dp"
                android:background="?android:attr/editTextBackground"
                android:textColor="?android:attr/textColorPrimary"
                android:textColorHint="?android:attr/textColorHint"/>

            <!-- Current Exercises Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/current_exercises"
                    android:textAppearance="@style/TextAppearance.AppCompat.Subhead"
                    android:textColor="?android:attr/textColorPrimary"/>

                <Button
                    android:id="@+id/addExerciseButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/add_exercises"
                    android:textColor="@color/actifitRed"
                    style="@style/Widget.AppCompat.Button.Borderless.Colored" />
            </LinearLayout>

            <TextView
                android:id="@+id/noExercisesMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/no_exercises_in_workout"
                android:textAlignment="center"
                android:paddingVertical="16dp"
                android:visibility="gone" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/editableExercisesRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                tools:listitem="@layout/editable_exercise_list_item" />

        </LinearLayout>
    </ScrollView>

    <Button
        android:id="@+id/saveChangesFab"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="38dp"
        android:clickable="true"
        android:focusable="true"
        android:text=""
        android:fontFamily="@font/font_awesome_6_solid"
        android:drawableStart="@drawable/ic_save_white_24dp"
        android:drawablePadding="0dp"
        android:textSize="16sp"
        android:textColor="@android:color/white"
        android:background="@drawable/fab_background_red_extended"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:elevation="6dp"
        android:translationZ="6dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
    />

    <include
        android:id="@+id/bottom_menu_container"
        layout="@layout/footer_menu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


</androidx.constraintlayout.widget.ConstraintLayout>