<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/loginContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/login_gradient_background">

    <!-- Background image (loaded dynamically from API) -->
    <ImageView
        android:id="@+id/login_hero"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:alpha="0.3"
        android:contentDescription="Login background" />

    <!-- Overlay to darken background -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#80000000" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="@dimen/spacing_lg">

            <!-- Logo & Branding -->
            <LinearLayout
                android:id="@+id/login_logo_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginBottom="@dimen/spacing_md"
                android:paddingTop="@dimen/spacing_xl">

                <ImageView
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:src="@drawable/actifit_logo"
                    android:contentDescription="Actifit Logo"
                    android:layout_marginBottom="@dimen/spacing_sm" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ACTIFIT"
                    android:textSize="@dimen/text_display"
                    android:textStyle="bold"
                    android:textColor="@color/md_theme_primary"
                    android:letterSpacing="0.1" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Move. Earn. Thrive."
                    android:textSize="@dimen/text_subtitle"
                    android:textColor="@color/md_theme_textSecondary"
                    android:layout_marginTop="@dimen/spacing_xs" />

            </LinearLayout>

            <!-- Login Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="@dimen/card_corner_radius"
                app:cardElevation="@dimen/card_elevation"
                app:cardBackgroundColor="@color/md_theme_cardBackground"
                android:layout_marginBottom="@dimen/spacing_md">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_lg">

                    <!-- Username Input -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Username"
                        app:boxBackgroundMode="outline"
                        app:boxCornerRadiusTopStart="@dimen/input_corner_radius"
                        app:boxCornerRadiusTopEnd="@dimen/input_corner_radius"
                        app:boxCornerRadiusBottomStart="@dimen/input_corner_radius"
                        app:boxCornerRadiusBottomEnd="@dimen/input_corner_radius"
                        app:startIconDrawable="@android:drawable/ic_menu_myplaces"
                        app:startIconTint="@color/md_theme_textSecondary"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/username_login"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="text"
                            android:maxLines="1"
                            android:textColor="@color/md_theme_onSurface"
                            android:textSize="@dimen/text_subtitle" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Posting Key Input with QR Button -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="@dimen/spacing_md">

                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:hint="Private Posting Key"
                            app:boxBackgroundMode="outline"
                            app:boxCornerRadiusTopStart="@dimen/input_corner_radius"
                            app:boxCornerRadiusTopEnd="0dp"
                            app:boxCornerRadiusBottomStart="@dimen/input_corner_radius"
                            app:boxCornerRadiusBottomEnd="0dp"
                            app:endIconMode="password_toggle"
                            app:startIconDrawable="@android:drawable/ic_lock_lock"
                            app:startIconTint="@color/md_theme_textSecondary"
                            style="@style/Widget.Material3.TextInputLayout.OutlinedBox">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/posting_key_login"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="textPassword"
                                android:maxLines="1"
                                android:textColor="@color/md_theme_onSurface"
                                android:textSize="@dimen/text_subtitle" />

                        </com.google.android.material.textfield.TextInputLayout>

                        <Button
                            android:id="@+id/qrCodeButton"
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:layout_marginStart="8dp"
                            android:backgroundTint="@color/md_theme_primary"
                            android:textSize="20sp"
                            android:fontFamily="@font/font_awesome_6_solid"
                            android:text="\uf029"
                            android:textStyle="bold"
                            android:textColor="@android:color/white"
                            app:cornerRadius="@dimen/input_corner_radius" />

                    </LinearLayout>

                    <!-- Login Button -->
                    <Button
                        android:id="@+id/loginButton"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/button_height"
                        android:layout_marginTop="@dimen/spacing_lg"
                        android:text="@string/login_title"
                        android:textSize="@dimen/text_subtitle"
                        android:textStyle="bold"
                        android:textAllCaps="false"
                        android:backgroundTint="@color/md_theme_primary"
                        app:cornerRadius="@dimen/button_corner_radius" />

                    <!-- Divider -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:layout_marginTop="@dimen/spacing_md"
                        android:layout_marginBottom="@dimen/spacing_md">

                        <View
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1"
                            android:background="@color/md_theme_separator" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="or"
                            android:textColor="@color/md_theme_textSecondary"
                            android:textSize="@dimen/text_body"
                            android:paddingStart="@dimen/spacing_sm"
                            android:paddingEnd="@dimen/spacing_sm" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1"
                            android:background="@color/md_theme_separator" />

                    </LinearLayout>

                    <!-- Guest/Skip Button -->
                    <Button
                        android:id="@+id/skipButton"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/button_height"
                        android:text="Continue as Guest"
                        android:textSize="@dimen/text_subtitle"
                        android:textAllCaps="false"
                        style="@style/AppTheme.ActifitButton.Outlined"
                        app:cornerRadius="@dimen/button_corner_radius" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Helper Links -->
            <TextView
                android:id="@+id/username_create_account_link"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/create_account_link"
                android:textSize="@dimen/text_body"
                android:textColor="@color/md_theme_primary"
                android:textStyle="italic"
                android:padding="@dimen/spacing_sm"
                android:gravity="end" />

            <TextView
                android:id="@+id/posting_key_link"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/actifit_find_posting_key_vid"
                android:textSize="@dimen/text_body"
                android:textColor="@color/md_theme_primary"
                android:textStyle="italic"
                android:padding="@dimen/spacing_sm"
                android:gravity="end" />

        </LinearLayout>

    </ScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
