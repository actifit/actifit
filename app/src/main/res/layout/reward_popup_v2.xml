<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:id="@+id/daily_rewards_dialog_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/spacing_md">

        <TextView
            android:id="@+id/dialogTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/rewards_note"
            android:textColor="@color/md_theme_onSurface"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="@dimen/spacing_xs" />

        <TextView
            android:id="@+id/daily_rewards_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/daily_rewards_description"
            android:textColor="@color/md_theme_textSecondary"
            android:textSize="@dimen/text_body"
            android:layout_marginBottom="@dimen/spacing_sm" />

        <TextView
            android:id="@+id/textViewCurrentSteps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="@color/md_theme_onSurface"
            android:textSize="@dimen/text_subtitle"
            android:textStyle="bold"
            android:layout_marginBottom="@dimen/spacing_md" />

        <TextView
            android:id="@+id/daily_reward_icon"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="&#127942;"
            android:textSize="28sp"
            android:layout_marginBottom="@dimen/spacing_sm" />

        <!-- Free tier -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_sm"
            app:cardBackgroundColor="@color/md_theme_cardBackground"
            app:cardCornerRadius="@dimen/card_corner_radius"
            app:cardElevation="@dimen/card_elevation">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_md">

                <TextView
                    android:id="@+id/textViewFreeRewardTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/daily_free_reward"
                    android:textColor="@color/md_theme_onSurface"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="@dimen/spacing_xs" />

                <TextView
                    android:id="@+id/textViewFreeRewardDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/free_daily_rewards_description"
                    android:textColor="@color/md_theme_textSecondary"
                    android:textSize="@dimen/text_body"
                    android:layout_marginBottom="@dimen/spacing_sm" />

                <Button
                    android:id="@+id/daily_free_reward"
                    style="@style/AppTheme.ActifitButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/claim_now" />

                <TextView
                    android:id="@+id/textViewFreeRewardStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:gravity="center"
                    android:textColor="@color/md_theme_textSecondary"
                    android:textSize="@dimen/text_body"
                    android:visibility="gone" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 5K tier -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_sm"
            app:cardBackgroundColor="@color/md_theme_cardBackground"
            app:cardCornerRadius="@dimen/card_corner_radius"
            app:cardElevation="@dimen/card_elevation">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_md">

                <TextView
                    android:id="@+id/textView5kRewardTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/daily_5k_reward"
                    android:textColor="@color/md_theme_onSurface"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="@dimen/spacing_xs" />

                <TextView
                    android:id="@+id/textView5kRewardDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/daily_5k_rewards_description"
                    android:textColor="@color/md_theme_textSecondary"
                    android:textSize="@dimen/text_body"
                    android:layout_marginBottom="@dimen/spacing_sm" />

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/progress_5k_reward"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/spacing_sm"
                    android:max="100"
                    android:visibility="gone"
                    app:indicatorColor="@color/actifitRed"
                    app:trackColor="@color/md_theme_separator"
                    app:trackThickness="3dp"
                    app:trackCornerRadius="2dp" />

                <Button
                    android:id="@+id/daily_5k_reward"
                    style="@style/AppTheme.ActifitButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/claim_now" />

                <TextView
                    android:id="@+id/textView5kRewardStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:gravity="center"
                    android:textColor="@color/md_theme_textSecondary"
                    android:textSize="@dimen/text_body"
                    android:visibility="gone" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 7K tier -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_sm"
            app:cardBackgroundColor="@color/md_theme_cardBackground"
            app:cardCornerRadius="@dimen/card_corner_radius"
            app:cardElevation="@dimen/card_elevation">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_md">

                <TextView
                    android:id="@+id/textView7kRewardTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/daily_7k_reward"
                    android:textColor="@color/md_theme_onSurface"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="@dimen/spacing_xs" />

                <TextView
                    android:id="@+id/textView7kRewardDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/daily_7k_rewards_description"
                    android:textColor="@color/md_theme_textSecondary"
                    android:textSize="@dimen/text_body"
                    android:layout_marginBottom="@dimen/spacing_sm" />

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/progress_7k_reward"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/spacing_sm"
                    android:max="100"
                    android:visibility="gone"
                    app:indicatorColor="@color/actifitRed"
                    app:trackColor="@color/md_theme_separator"
                    app:trackThickness="3dp"
                    app:trackCornerRadius="2dp" />

                <Button
                    android:id="@+id/daily_7k_reward"
                    style="@style/AppTheme.ActifitButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/claim_now" />

                <TextView
                    android:id="@+id/textView7kRewardStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:gravity="center"
                    android:textColor="@color/md_theme_textSecondary"
                    android:textSize="@dimen/text_body"
                    android:visibility="gone" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 10K tier -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_sm"
            app:cardBackgroundColor="@color/md_theme_cardBackground"
            app:cardCornerRadius="@dimen/card_corner_radius"
            app:cardElevation="@dimen/card_elevation">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_md">

                <TextView
                    android:id="@+id/textView10kRewardTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/daily_10k_reward"
                    android:textColor="@color/md_theme_onSurface"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="@dimen/spacing_xs" />

                <TextView
                    android:id="@+id/textView10kRewardDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/daily_10k_rewards_description"
                    android:textColor="@color/md_theme_textSecondary"
                    android:textSize="@dimen/text_body"
                    android:layout_marginBottom="@dimen/spacing_sm" />

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/progress_10k_reward"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/spacing_sm"
                    android:max="100"
                    android:visibility="gone"
                    app:indicatorColor="@color/actifitRed"
                    app:trackColor="@color/md_theme_separator"
                    app:trackThickness="3dp"
                    app:trackCornerRadius="2dp" />

                <Button
                    android:id="@+id/daily_10k_reward"
                    style="@style/AppTheme.ActifitButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/claim_now" />

                <TextView
                    android:id="@+id/textView10kRewardStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:gravity="center"
                    android:textColor="@color/md_theme_textSecondary"
                    android:textSize="@dimen/text_body"
                    android:visibility="gone" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>
