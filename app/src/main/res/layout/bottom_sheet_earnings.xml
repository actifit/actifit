<?xml version="1.0" encoding="utf-8"?>
<!-- "Your token earnings" sheet, opened from the earnings panel on the main screen.
     Token rows are added from EarningsSheet using item_earnings_token. -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/spacing_md"
        android:paddingEnd="@dimen/spacing_md"
        android:paddingTop="@dimen/spacing_sm"
        android:paddingBottom="@dimen/spacing_md">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/earnings_sheet_title"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/md_theme_onSurface"
            android:accessibilityHeading="true"
            android:paddingBottom="@dimen/spacing_sm" />

        <LinearLayout
            android:id="@+id/earnings_token_rows"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="@dimen/spacing_sm"
            android:layout_marginBottom="@dimen/spacing_md"
            android:background="@color/md_theme_separator" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/earnings_how_title"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/md_theme_onSurface"
            android:accessibilityHeading="true"
            android:paddingBottom="@dimen/spacing_xs" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="@dimen/spacing_xs"
            android:paddingBottom="@dimen/spacing_xs">

            <TextView
                android:layout_width="28dp"
                android:layout_height="wrap_content"
                android:importantForAccessibility="no"
                android:text="👟"
                android:textSize="14sp"
                tools:ignore="HardcodedText" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/earnings_how_min_activity"
                android:textSize="14sp"
                android:textColor="@color/md_theme_textSecondary" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="@dimen/spacing_xs"
            android:paddingBottom="@dimen/spacing_xs">

            <TextView
                android:layout_width="28dp"
                android:layout_height="wrap_content"
                android:importantForAccessibility="no"
                android:text="⏱"
                android:textSize="14sp"
                tools:ignore="HardcodedText" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/earnings_how_afit_timing"
                android:textSize="14sp"
                android:textColor="@color/md_theme_textSecondary" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="@dimen/spacing_xs"
            android:paddingBottom="@dimen/spacing_xs">

            <TextView
                android:layout_width="28dp"
                android:layout_height="wrap_content"
                android:importantForAccessibility="no"
                android:text="📅"
                android:textSize="14sp"
                tools:ignore="HardcodedText" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/earnings_how_other_timing"
                android:textSize="14sp"
                android:textColor="@color/md_theme_textSecondary" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/earnings_got_it"
            style="@style/AppTheme.ActifitButton"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:layout_marginTop="@dimen/spacing_md"
            android:text="@string/earnings_got_it" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
