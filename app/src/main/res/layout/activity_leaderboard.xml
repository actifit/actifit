<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/md_theme_background">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="@dimen/spacing_md"
        android:gravity="center_vertical"
        android:background="@color/md_theme_surface">

        <TextView
            android:id="@+id/textView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/activity_leaderboard_title"
            android:textColor="@color/md_theme_primary"
            android:textSize="@dimen/text_title"
            android:textStyle="bold" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/md_theme_separator" />

    <!-- Column headers -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="@dimen/spacing_sm"
        android:paddingEnd="@dimen/spacing_sm"
        android:paddingTop="@dimen/spacing_xs"
        android:paddingBottom="@dimen/spacing_xs"
        android:background="@color/md_theme_surface"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="40dp"
            android:layout_height="wrap_content"
            android:text="#"
            android:textStyle="bold"
            android:textSize="@dimen/text_body"
            android:textColor="@color/md_theme_textSecondary"
            android:gravity="center" />

        <View
            android:layout_width="36dp"
            android:layout_height="1dp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="User"
            android:textStyle="bold"
            android:textSize="@dimen/text_body"
            android:textColor="@color/md_theme_textSecondary"
            android:paddingStart="@dimen/spacing_xs" />

        <TextView
            android:layout_width="80dp"
            android:layout_height="wrap_content"
            android:text="Steps"
            android:textStyle="bold"
            android:textSize="@dimen/text_body"
            android:textColor="@color/md_theme_textSecondary"
            android:gravity="end" />

        <View
            android:layout_width="44dp"
            android:layout_height="1dp" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/md_theme_separator" />

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:id="@+id/progressBarRelLayout"
        android:visibility="visible"
        android:layout_weight="1">

        <ProgressBar
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_centerInParent="true" />

    </RelativeLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ListView
            android:id="@+id/accounts_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:dividerHeight="1dp"
            android:divider="@color/md_theme_separator" />

        <TextView
            android:id="@+id/leaderboard_empty_state"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:textColor="@color/md_theme_textSecondary"
            android:textSize="@dimen/text_subtitle"
            android:padding="@dimen/spacing_lg"
            android:gravity="center"
            android:visibility="gone" />

    </FrameLayout>

    <include
        android:id="@+id/bottom_menu_container"
        layout="@layout/footer_menu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

</LinearLayout>
