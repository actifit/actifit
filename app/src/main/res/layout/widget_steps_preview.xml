<?xml version="1.0" encoding="utf-8"?>
<!-- Widget picker preview (Android 12+): the small layout with static sample values. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:padding="3dp">

    <ImageView
        android:layout_width="14dp"
        android:layout_height="14dp"
        android:layout_gravity="top|start"
        android:layout_margin="3dp"
        android:importantForAccessibility="no"
        android:src="@drawable/actifit_logo" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="68dp"
            android:layout_height="68dp">

            <ProgressBar
                android:id="@+id/widget_ring_steps"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:indeterminate="false"
                android:max="100"
                android:progress="62"
                android:progressDrawable="@drawable/widget_ring_steps" />

            <ProgressBar
                android:id="@+id/widget_ring_distance"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_margin="7dp"
                android:indeterminate="false"
                android:max="100"
                android:progress="59"
                android:progressDrawable="@drawable/widget_ring_distance" />

            <ProgressBar
                android:id="@+id/widget_ring_kcal"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_margin="14dp"
                android:indeterminate="false"
                android:max="100"
                android:progress="50"
                android:progressDrawable="@drawable/widget_ring_kcal" />

            <TextView
                android:id="@+id/widget_animal_emoji"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:text="&#x1F43A;"
                android:textSize="15sp" />
        </FrameLayout>

        <TextView
            android:id="@+id/widget_steps"
            android:layout_width="match_parent"
            android:layout_height="18dp"
            android:gravity="center"
            android:maxLines="1"
            android:text="6,240"
            android:textColor="@color/widget_text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>
</FrameLayout>
